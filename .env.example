# Shared
APP_ENV=development
DEFAULT_LOCALE=it

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-dev-only-service-role-key

# Mobile Flutter -- pass with --dart-define or your CI secret system
BB_SUPABASE_URL=https://your-project-ref.supabase.co
BB_SUPABASE_ANON_KEY=your-anon-key
BB_ENABLE_FIREBASE_MESSAGING=false
BB_AI_PROVIDER=mock

# Admin Flutter web
BB_ADMIN_SUPABASE_URL=https://your-project-ref.supabase.co
BB_ADMIN_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions
BB_FUNCTION_ALLOWED_ORIGIN=http://localhost:3000
